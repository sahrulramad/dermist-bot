# Discord Bot Configuration
# Salin file ini ke .env dan isi nilai sebenarnya

# Token bot dari Discord Developer Portal
DISCORD_TOKEN=

# ID aplikasi/bot dari Developer Portal (General Information -> Application ID)
CLIENT_ID=

# ID server (guild) kamu untuk register slash command saat development
# Klik kanan server name di Discord -> Copy ID (aktifkan Developer Mode di Settings -> Advanced)
GUILD_ID=

# ID channel untuk pesan welcome/goodbye (opsional, kosongkan untuk nonaktifkan)
WELCOME_CHANNEL_ID=

# ID role yang otomatis diberikan saat member join (opsional, kosongkan untuk nonaktifkan)
AUTO_ROLE_ID=

# ID channel untuk log aktivitas server (opsional, kosongkan untuk nonaktifkan)
LOG_CHANNEL_ID=

# Cloudflare Workers AI & KV (Bisa pakai akun Cloudflare pribadi / Free Tier)
# Dapatkan dari Cloudflare Dashboard -> Workers & Pages -> Overview (Account ID ada di sidebar kanan)
CF_ACCOUNT_ID=
# Buat API Token di Cloudflare Dashboard -> My Profile -> API Tokens -> Create Custom Token (Permissions: Workers AI Read/Edit, Workers KV Storage Read/Edit)
CF_API_TOKEN=

# Cloudflare KV (untuk memory cloud)
CF_KV_NAMESPACE_ID=
CF_KV_TOKEN=

# Cloudflare Worker Integration (Opsional - isi jika mendeploy dermist-ai-agent Worker)
# Contoh: https://dermist-ai-agent.<subdomain>.workers.dev
WORKER_BASE_URL=
# Secret auth token yang diset via `wrangler secret put AUTH_SECRET`
WORKER_AUTH_SECRET=
