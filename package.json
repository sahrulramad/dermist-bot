{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Complex Discord bot with moderation, channel management, welcome, auto-role, logging, and slash commands.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "worker:ai:dev": "npm --prefix workers/ai-agent run dev",
    "worker:ai:deploy": "npm --prefix workers/ai-agent run deploy",
    "worker:cron:dev": "npm --prefix workers/cron-jobs run dev",
    "worker:cron:deploy": "npm --prefix workers/cron-jobs run deploy",
    "vault:sync": "node scripts/vault-sync.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  }
}
